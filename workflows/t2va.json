{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "PRISM_DMAD_PDMD_int8.safetensors",
      "weight_dtype": "default"
    }
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": ["unet", 0],
      "lora_name": "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
      "strength_model": 1.0
    }
  },
  "attention": {
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "model": ["lora", 0],
      "attention": "comfy kitchen attention"
    }
  },
  "sparse": {
    "class_type": "BlockSparseAttention",
    "inputs": {
      "model": ["attention", 0],
      "selection": "sol-attn",
      "selection.tau": 1.3,
      "start_percent": 0.2,
      "end_percent": 1,
      "dense_blocks": "",
      "min_tokens": 12288,
      "extra_tokens": 256,
      "sink_conditioning": "exact_kv_and_rows",
      "verbose": false
    }
  },
  "text_encoder": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_heretic_minimax_h3_nvfp4.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "video_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "audio_vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "seconds": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 12
    }
  },
  "frames": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "values.a": ["seconds", 0],
      "expression": "max(5, round(a * 24)) + (5 - (max(5, round(a * 24)) % 17)) % 17"
    }
  },
  "latent": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "prompt": "",
      "width": 1024,
      "height": 576,
      "length": ["frames", 1],
      "clip": ["text_encoder", 0],
      "vae": ["video_vae", 0]
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "scheduler": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": ["sparse", 0],
      "scheduler": "beta",
      "steps": 8,
      "denoise": 1
    }
  },
  "guider": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": ["sparse", 0],
      "conditioning": ["latent", 0]
    }
  },
  "sample": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["noise", 0],
      "guider": ["guider", 0],
      "sampler": ["sampler", 0],
      "sigmas": ["scheduler", 0],
      "latent_image": ["latent", 1]
    }
  },
  "decode_video": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["video_vae", 0]
    }
  },
  "decode_audio": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": ["sample", 0],
      "vae": ["audio_vae", 0]
    }
  },
  "save": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["decode_video", 0],
      "audio": ["decode_audio", 0],
      "frame_rate": 24,
      "loop_count": 0,
      "filename_prefix": "video/t2va",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 20,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true
    }
  }
}
